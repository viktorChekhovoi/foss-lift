{
  "name": "foss-lift-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "test:cloud": "esbuild server/worker.js --bundle --format=esm --outfile=build/cloud-test/worker.js && node --test server/test/*.test.mjs",
    "prepare:web": "node tool/prepare-web.mjs",
    "test:web": "node tool/test-web.mjs",
    "dev:cloud": "node tool/provision-cloud.mjs --local && wrangler d1 migrations apply DB --local --config=build/wrangler.local.json && wrangler pages dev build/web --config=build/wrangler.local.json --port=8788",
    "setup:cloud": "node tool/provision-cloud.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "playwright": "1.64.1",
    "wrangler": "4.154.0"
  }
}
