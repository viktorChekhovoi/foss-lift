  "sessionRestPlain": "Rest, then lift.",
  "@sessionRestPlain": {
    "description": "Caption on the rest bar when there is nothing to set up: the next set is at the weight already loaded. Says what to do, not what is happening — the clock beside it already says that. Two or three words; the bar is one line above a countdown and three buttons."
  },
  "sessionRestMinus": "−15s",
