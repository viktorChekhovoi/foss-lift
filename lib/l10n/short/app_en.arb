    "description": "Tooltip on the bin icon that throws the running workout away. Sits one tap from Finish, so it must not read like a way of completing the session."
  },
  "sessionFinish": "Finish",
  "@sessionFinish": {
    "description": "Button that ends the workout and writes it to history. One short word — it shares the top bar with the workout's name and must not push the name out."
  },
  "sessionFinishUnloggedConfirm": "Finish anyway",
  "@sessionFinishUnloggedConfirm": {
    "description": "Confirms the unlogged-sets dialog: writes the session as it stands and advances progression."
  },
  "sessionAbortTitle": "Abort this workout?",
  "@sessionAbortTitle": {
    "description": "Title of the dialog confirming that the running workout will be thrown away."
  },
  "sessionAbortKeep": "Keep going",
  "@sessionAbortKeep": {
    "description": "Dismisses the abort dialog and leaves the workout running."
  },
  "sessionAbortConfirm": "Abort",
  "@sessionAbortConfirm": {
    "description": "Confirms the abort dialog and discards the workout. Deliberately not the default action."
  },
  "sessionStatDuration": "Duration",
  "@sessionStatDuration": {
    "description": "Caption under the running clock in the strip at the top of the board. Rendered in small capitals under the number; keep it to one word — it shares the strip with the set count."
  },
  "sessionStatSets": "Sets",
  "@sessionStatSets": {
    "description": "Caption under the done/total set count in the strip at the top of the board (e.g. under \"3/8\"). Rendered in small capitals; keep it to one word."
  },
  "sessionWorkingSets": "WORKING SETS",
  "@sessionWorkingSets": {
    "description": "Label over an exercise's real sets, shown only when a warm-up ramp sits above them. Rendered in small capitals, and it ellipsises before the weight control beside it does — keep it short."
  },
  "sessionWarmupLabel": "WARM-UP",
  "@sessionWarmupLabel": {
    "description": "Label on the collapsed warm-up group above an exercise's working sets. Rendered in small capitals on one line with the count beside it; keep it short."
  },
  "sessionWarmupSets": "Sets",
  "@sessionWarmupSets": {
    "description": "Label beside the -/+ stepper that sets how many warm-up rungs the ramp has. Rendered in small capitals inside the opened group."
  },
  "sessionWarmupTitle": "Warm-up {number}",
  "@sessionWarmupTitle": {
    "description": "Title of the weight dialog for a single warm-up rung. {number} counts from 1 up the ramp.",
    "placeholders": {
      "number": {
        "type": "int"
      }
    }
  },
  "sessionWarmupOnly": "This rung only",
  "@sessionWarmupOnly": {
    "description": "Subtitle in the weight dialog for a warm-up rung: the typed weight changes that rung and leaves the rest of the ramp alone."
  },
  "sessionSetTitle": "Set {number}",
  "@sessionSetTitle": {
    "description": "Title of the weight dialog for a single working set. {number} counts from 1 down the exercise.",
    "placeholders": {
      "number": {
        "type": "int"
      }
    }
  },
  "sessionSetOnly": "This set only",
  "@sessionSetOnly": {
    "description": "Subtitle in the weight dialog for one set: the typed weight changes that set and leaves the exercise's working weight alone."
  },
  "sessionColSet": "Set",
  "@sessionColSet": {
    "description": "Heading over the set-number column on the live board. The app renders it in capitals. The column is 40 logical pixels wide and never grows — one short word, and an abbreviation is fine."
  },
  "sessionColRepsDone": "Reps done",
  "@sessionColRepsDone": {
    "description": "Heading over the column where each set's result is tapped in, on an exercise counted in reps. The app renders it in capitals, and the column is already tight at large text sizes — abbreviate rather than wrap."
  },
  "sessionColSecHeld": "Sec held",
  "@sessionColSecHeld": {
    "description": "The same column heading on an exercise held for time — seconds held rather than reps done. Already abbreviated in English for width; abbreviate freely."
  },
  "sessionGoalCounted": "{sets} × {reps}",
  "@sessionGoalCounted": {
    "description": "What an exercise is aiming at, stated once on the line above its sets: three sets of eight reads \"3 × 8\". Spoken as \"three eights\" — the multiplication sign is the whole of the wording, and the weight is not in here.",
    "placeholders": {
      "sets": {
        "type": "int"
      },
      "reps": {
        "type": "int"
      }
    }
  },
  "sessionGoalTimed": "{sets} × {seconds}s",
  "@sessionGoalTimed": {
    "description": "The same goal for an exercise held for time: two forty-five-second holds read \"2 × 45s\". The trailing letter is the seconds abbreviation and shares a tight line with the weight control.",
    "placeholders": {
      "sets": {
        "type": "int"
      },
      "seconds": {
        "type": "int"
      }
    }
  },
  "sessionAddNote": "Add a note",
