  "backupFinishWorkoutFirst": "Finish or abandon the workout first.",
  "@backupFinishWorkoutFirst": {
    "description": "Shown when a restore or a profile reset is asked for while a workout is running. The live workout is only written to history when it is finished, so replacing the database under it would throw it away. One string for both, because it is the same refusal for the same reason. 'Finish' and 'abandon' are the two words the session screen uses — sessionFinish and sessionAbort."
  },
  "aboutSubtitle": "An offline workout tracker.",
  "@aboutSubtitle": {
    "description": "One-line description under the app name at the top of the about screen. Offline means it works with no network at all."
  },
  "aboutDataSection": "WHAT IT DOES WITH YOUR DATA",
  "@aboutDataSection": {
    "description": "Heading over the privacy statement on the about screen. Rendered in small capitals by the app — the capitals are the app's styling, not part of the words."
  },
  "aboutDataPara1": "Nothing leaves this phone. No account, no server, no analytics. The app asks for no network permission, so it could not send your training anywhere if it wanted to.",
  "@aboutDataPara1": {
    "description": "First paragraph of the app's privacy statement, on the about screen. This is a factual claim about what the software does and its meaning is load-bearing: translate it exactly, without softening it ('almost nothing', 'we try not to') and without embellishing it with claims it does not make. Keep it as one paragraph. 'Network permission' is the Android permission an app must declare before it can reach the internet."
  },
  "aboutDataPara2": "Two things reach outside, and both hand off to another app you can see: opening a demo link in your browser, and passing a share code to the share sheet.",
  "@aboutDataPara2": {
    "description": "Second paragraph of the app's privacy statement, naming the only two exceptions to the first. Its meaning is load-bearing: translate it exactly, neither softening nor embellishing, and keep it as one paragraph. The 'share sheet' is the system dialog Android shows for sending something to another app."
  },
  "aboutLicenseBody": "AGPL-3.0. You may use, inspect, modify, and share Foss Lift under the terms of its license.",
  "@aboutLicenseBody": {
    "description": "The license statement on the about screen. 'AGPL-3.0' is the identifier of the GNU Affero General Public License version 3 — a proper noun that is never translated or spelled differently. Keep it as one paragraph."
  },
  "aboutBugReportSubject": "Foss Lift bug report",
  "@aboutBugReportSubject": {
    "description": "Subject line pre-filled into the mail draft the bug-report button opens. Not shown in the app itself; the user sees it in their mail app. 'Foss Lift' is the app's name and stays as it is."
  },
  "barSettingsEmpty": "No bars. Barbell lifts count {weight} until you add one.",
