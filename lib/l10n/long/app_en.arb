      },
      "misses": {
        "type": "int"
      }
    }
  },
  "itemEditorProgressionRuleCycle": "Adds {step} to the training max at the end of a clean cycle; drops {back} after {misses, plural, =1{1 missed session} other{{misses} missed sessions}} in it.",
  "@itemEditorProgressionRuleCycle": {
    "description": "The progression numbers of a slot running a cycle, read back as the rule they add up to. Different from itemEditorProgressionRule in two ways: what moves is the training max the sets are percentages of, and it moves only when the cycle comes round rather than after a run of clean sessions. The misses are counted anywhere in the cycle rather than in a row, so no branch of this one says \"in a row\". The amounts arrive already formatted in their own unit.",
    "placeholders": {
      "step": {
        "type": "String",
        "example": "2.5 kg"
      },
      "back": {
        "type": "String",
        "example": "5 kg"
      },
      "misses": {
        "type": "int"
      }
    }
  },
  "itemEditorCycleWhat": "What is a cycle?",
  "@itemEditorCycleWhat": {
    "description": "Title of the dialog behind the info tap beside the Set scheme label. A question, as the superset one is."
  },
  "itemEditorCycleExplained": "A cycle repeats an ordered list of phases—often weeks, but they can represent any sequence you choose. Each workout uses the next phase’s sets and percentages. The weight field is your training max, not that day’s bar weight. Foss Lift changes the training max only after the final phase.",
  "@itemEditorCycleExplained": {
    "description": "The body of that dialog: what a cycle is, for somebody deciding whether to pick one. Keep it to three short sentences, and keep it about the shape — naming a particular program here would make the general tool read as that program's setting."
  },
  "themeQrCaption": "Point another phone at this. Foss Lift will ask before changing anything.",
  "@themeQrCaption": {
    "description": "Caption under the QR code. The second sentence is a promise that scanning cannot repaint the other phone without its owner agreeing. Foss Lift is the app's name and stays as it is."
  },
  "themePasteHint": "FLT1.… or a fosslift:// link",
