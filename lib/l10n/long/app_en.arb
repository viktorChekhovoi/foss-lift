  "itemEditorSupersetWhat": "What is a superset?",
  "@itemEditorSupersetWhat": {
    "description": "The tooltip on the info icon beside the superset checkbox, and the title of the box it opens. A question, because that is what the icon is answering."
  },
  "itemEditorSupersetExplained": "Two or more exercises performed back to back with no rest between them, saving time in the gym.",
  "@itemEditorSupersetExplained": {
    "description": "What a superset is, for somebody who has just been offered one: what it is, then why anybody does it. The only place in the app outside the tour where a training term is defined."
  },
