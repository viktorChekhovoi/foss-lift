{
  "@@locale": "en",
  "commonCancel": "Cancel",
  "commonContinue": "Continue",
  "@commonContinue": {
    "description": "Accepts the choice on screen and moves on. Used by the first-run weight-unit question."
  },
  "@commonCancel": {
    "description": "Dismisses a dialog without doing the thing it offered."
  },
  "commonSave": "Save",
  "@commonSave": {
    "description": "Commits an edit on a form."
  },
  "commonDelete": "Delete",
  "@commonDelete": {
    "description": "Removes the thing being looked at."
  },
  "commonDone": "Done",
  "@commonDone": {
    "description": "Closes a screen that has finished its job."
  },
  "commonEdit": "Edit",
  "@commonEdit": {
    "description": "Opens the editor for the thing being looked at."
  },
  "commonAdd": "Add",
  "@commonAdd": {
    "description": "Adds a new one of whatever the screen lists."
  },
  "commonBack": "Back",
  "@commonBack": {
    "description": "Leaves a screen that has nothing to do but be left — under an error message on the scanner, the recorder, the clip player, a routine code or a theme code that would not read, and back to the list from a past session. Sits on an outlined button and on a back arrow’s tooltip, so it has to stay short."
  },
  "commonProgress": "Progress",
  "@commonProgress": {
    "description": "One movement’s chart over time: the button that opens it on the exercise detail screen, and the title of the screen it opens. Progress here is a lifter getting stronger, not a task completing."
  },
  "commonName": "Name",
  "@commonName": {
    "description": "Label or placeholder on the field naming the thing being edited — a routine, a workout, a movement, a bar, a theme. Rendered in small capitals by the app in some places; write it in ordinary case."
  },
  "commonSaving": "Saving…",
  "@commonSaving": {
    "description": "Replaces the save button’s own label while the write is in flight. Has to fit the same button Save fits."
  },
  "commonNewExercise": "New exercise",
  "@commonNewExercise": {
    "description": "Opens the form for a movement you define yourself: the floating button in the exercise library, and the row above the list in the exercise picker. Sits beside a + icon, so it has to stay short enough for a button."
  },
  "commonSearchExercises": "Search exercises…",
  "@commonSearchExercises": {
    "description": "Placeholder inside the search box over a list of movements — the exercise library, and the picker sheet in the routine builder."
  },
  "commonExerciseGone": "This exercise no longer exists.",
  "@commonExerciseGone": {
    "description": "Shown in place of a movement’s detail or its progress chart when it was deleted from the library while the screen was open."
  },
  "commonAddBar": "Add a bar",
  "@commonAddBar": {
    "description": "Opens the new-bar dialog, and titles it: the last row of the bar list in settings and of the bar picker. A bar here is a barbell — the steel a lift is loaded on, an EZ bar or a trap bar — not a counter."
  },
  "commonShowQr": "Show QR",
  "@commonShowQr": {
    "description": "Button that displays a routine’s or a theme’s code full screen as a QR symbol for another phone to point at. “QR” is the international name of the symbol and stays. Sits on a half-width button beside Send code, so it has to stay short."
  },
  "commonSendCode": "Send code",
  "@commonSendCode": {
    "description": "Button that hands a routine’s or a theme’s text code to the system share sheet — a chat app, the clipboard, a nearby-share. Sits on a half-width button beside Show QR, so it has to stay short."
  },
  "commonSetCount": "{count, plural, =1{1 set} other{{count} sets}}",
  "@commonSetCount": {
    "description": "How many sets were logged — for a whole past session on its row in History, and for one movement on its row in the session summary.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "commonExerciseCount": "{count, plural, =1{1 exercise} other{{count} exercises}}",
  "@commonExerciseCount": {
    "description": "How many exercises a workout holds, under its name in the routine’s list and in the routine builder.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "commonEstimatedMinutes": "~{minutes} min",
  "@commonEstimatedMinutes": {
    "description": "How long a workout is estimated to take, in minutes, rounded to the nearest five. Shown beside the exercise count on the workout and on its Today card. The tilde marks it as approximate.",
    "placeholders": {
      "minutes": {
        "type": "int",
        "example": "45"
      }
    }
  },
  "commonClipCount": "{count, plural, =1{1 clip} other{{count} clips}}",
  "@commonClipCount": {
    "description": "How many recorded set clips there are — on the button opening one movement’s reel, and in settings beside the bytes they occupy. A clip is a few seconds of video of a single set.",
    "placeholders": {
      "count": {
        "type": "int",
        "example": "4"
      }
    }
  },
  "unitWeightShort": "{amount} {unit}",
  "@unitWeightShort": {
    "description": "A weight and its unit together, e.g. “82.5 kg”. `amount` is already formatted for the language (82,5 on a Ukrainian phone) and `unit` is unitKgSuffix or unitLbSuffix. Reorder or close the gap if your language writes it differently.",
    "placeholders": {
      "amount": {
        "type": "String",
        "example": "82.5"
      },
      "unit": {
        "type": "String",
        "example": "kg"
      }
    }
  },
  "unitSecondsShort": "{seconds}s",
  "@unitSecondsShort": {
    "description": "A duration in seconds, written as tightly as the language allows — this sits in a table row, in a fixed-width chip beside a stop icon, beside a chart point and on the live-workout notification. English closes the gap (45s); a language that needs a space should have one.",
    "placeholders": {
      "seconds": {
        "type": "String",
        "example": "45"
      }
    }
  },
  "languageTitle": "Language",
  "@languageTitle": {
