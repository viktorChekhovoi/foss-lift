    "description": "Card title over the default warm-up rung count on the exercise settings screen."
  },
  "settingsWarmupSets": "Sets",
  "@settingsWarmupSets": {
    "description": "Field label over the stepper that sets how many warm-up rungs every exercise opens with. Rendered in small capitals; keep it short."
  },
  "settingsDeload": "Deload after time off",
  "@settingsDeload": {
    "description": "Card title over the layoff rules. A deload is a deliberate reduction in training load."
  },
  "settingsDeloadAfter": "After",
  "@settingsDeloadAfter": {
    "description": "Field label over the number of days away that triggers a back-off."
  },
  "settingsDeloadCut": "Cut",
  "@settingsDeloadCut": {
    "description": "Field label over the percentage a layoff takes off the target."
  },
  "settingsDeloadPerPeriod": "per period",
  "@settingsDeloadPerPeriod": {
    "description": "Note under the Cut field: the percentage applies once per whole period away, and stacks."
  },
  "settingsDeloadOff": "Off",
  "@settingsDeloadOff": {
    "description": "Shown in place of a number of days when layoff deloads are switched off entirely."
  },
  "settingsDeloadOffNote": "Returning to a workout after any gap starts it at the weight you left it at.",
  "@settingsDeloadOffNote": {
    "description": "Caption under the layoff card when the feature is switched off."
  },
  "settingsDeloadOnNote": "Go {days} days without a workout and starting it again offers to cut its targets by {percent}% — twice that after {doubleDays} days, and no more than {maxCut}% however long you are away.",
  "@settingsDeloadOnNote": {
    "description": "Caption under the layoff card explaining the configured rule in full.",
    "placeholders": {
      "days": {
        "type": "int"
      },
      "percent": {
        "type": "int"
      },
      "doubleDays": {
        "type": "int"
      },
      "maxCut": {
        "type": "int"
      }
    }
  },
