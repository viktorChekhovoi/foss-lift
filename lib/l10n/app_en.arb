  "settingsStorage": "Storage",
  "@settingsStorage": {
    "description": "Row label: how much disk the filmed sets take up."
  },
  "settingsTextSize": "TEXT SIZE",
  "@settingsTextSize": {
    "description": "Section heading over the text-size chips. Rendered in small capitals."
  },
  "settingsTextSizeNote": "On top of your phone’s own text size, which the app follows either way.",
