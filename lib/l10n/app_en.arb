    "description": "Line under the incoming routine's name, above the list of what accepting it would bring in. Conditional on purpose: nothing has been added yet."
  },
  "routineImportNewExercises": "NEW EXERCISES",
  "@routineImportNewExercises": {
    "description": "Section heading over the movements in the incoming routine that the recipient does not already have. Rendered in small capitals; translate as a heading, not a sentence."
  },
  "routineImportAddedToLibrary": "Added to your library.",
  "@routineImportAddedToLibrary": {
    "description": "One line under the NEW EXERCISES heading saying where those movements will end up — the recipient's own exercise library."
  },
  "routineImportNameClashes": "NAMES YOU ALREADY USE",
  "@routineImportNameClashes": {
    "description": "Section heading over the incoming movements whose names are already taken in the recipient's library. Rendered in small capitals; translate as a heading, not a sentence."
  },
  "routineImportClashHelp": "Your logged exercise history is kept.",
  "@routineImportClashHelp": {
    "description": "One line under the NAMES YOU ALREADY USE heading, answering the question the Keep mine / Use theirs switch raises: taking the sender's definition of a movement does not touch the sets already logged against it."
  },
  "routineImportKeepMine": "Keep mine",
  "@routineImportKeepMine": {
    "description": "State of a name-clash row with its switch off: the recipient's own definition of the movement wins. Rendered in a monospaced font under the movement's name."
  },
  "routineImportUseTheirs": "Use theirs",
  "@routineImportUseTheirs": {
    "description": "State of a name-clash row with its switch on: the incoming definition of the movement overwrites the recipient's. Rendered in a monospaced font under the movement's name."
  },
  "routineImportAdd": "Add this routine",
  "@routineImportAdd": {
    "description": "The button that accepts the incoming routine. The only place a shared routine is ever adopted."
  },
  "routineImportFootnote": "Adds a routine. Nothing you have is removed or replaced.",
  "@routineImportFootnote": {
    "description": "Small print under the Add and Cancel buttons: accepting the routine is additive, whatever else is already in the app."
  },
  "targetSetsReps": "{sets} × {reps}",
  "@targetSetsReps": {
    "description": "What one exercise slot is aiming at: four sets of six to eight reads \"4 × 6–8\". Used wherever a slot is summarised — the workout detail screen, the exercise editor's summary line, the incoming routine on the import confirmation — usually in a monospaced font at the right edge of a row. `reps` is already formatted: a number, a range like 6–8, a hold like 45s, or targetFailure.",
    "placeholders": {
      "sets": {
        "type": "int",
        "example": "4"
      },
      "reps": {
        "type": "String",
        "example": "6–8"
      }
    }
  },
  "targetFailure": "Failure",
  "@targetFailure": {
    "description": "Stands in for a rep count on a slot that asks for as many reps as can be done — \"3 × Failure\". A term of art in weight training: the point where another rep is not possible, not a fault."
  },
  "scanRoutineTitle": "Scan a routine",
  "@scanRoutineTitle": {
    "description": "App bar title while the camera is looking for a routine QR code."
  },
  "scanThemeTitle": "Scan a theme",
  "@scanThemeTitle": {
    "description": "App bar title while the camera is looking for a color-theme QR code."
  },
  "scanRoutineHint": "Point the camera at a Foss Lift routine QR code.",
  "@scanRoutineHint": {
    "description": "Line under the viewfinder saying what the scanner is looking for. \"QR\" is the international name of the symbol and stays."
  },
  "scanThemeHint": "Point the camera at a Foss Lift theme QR code.",
  "@scanThemeHint": {
    "description": "The color-theme counterpart of scanRoutineHint."
  },
  "scanRoutineDenied": "Foss Lift needs the camera to scan a code. You can still paste a routine code instead.",
  "@scanRoutineDenied": {
    "description": "Shown in place of the viewfinder when camera permission was refused. The second sentence points at the paste dialog on the screen the user came from, which needs no camera."
  },
  "scanThemeDenied": "Foss Lift needs the camera to scan a code. You can still paste a theme code instead.",
  "@scanThemeDenied": {
    "description": "The color-theme counterpart of scanRoutineDenied."
  },
  "setVideoTitle": "Record this set",
  "@setVideoTitle": {
    "description": "App bar title of the screen that films one set of the workout in progress."
  },
  "setVideoStoppingIn": "Stopping in {seconds}",
  "@setVideoStoppingIn": {
    "description": "The countdown over the shutter in the last five seconds of a recording, which stops itself at the limit. Rendered large in a monospaced font, so keep it short.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "3"
      }
    }
  },
  "setVideoSecondsLeft": "{seconds} s left",
  "@setVideoSecondsLeft": {
    "description": "How much of the recording limit is left, shown quietly over the shutter until the last five seconds. The lone letter is the seconds abbreviation. Rendered in a monospaced font on one line.",
    "placeholders": {
      "seconds": {
        "type": "int",
        "example": "24"
      }
    }
  },
  "setVideoCameraDenied": "Foss Lift needs the camera to film a set. Clips stay on this phone.",
  "@setVideoCameraDenied": {
    "description": "Shown in place of the viewfinder when camera permission was refused before filming a set. The second sentence answers the question the permission prompt raises: nothing filmed is uploaded anywhere."
  },
  "clipPlayerTitle": "Clip",
  "@clipPlayerTitle": {
    "description": "App bar title of the video player when it was opened without a label for the set — normally the label from the reel is shown instead. One word, on a narrow bar."
  },
  "clipPlayerDeleteTitle": "Delete this clip?",
  "@clipPlayerDeleteTitle": {
    "description": "Title of the dialog confirming that the recording of a set should be removed."
  },
  "clipPlayerDeleteBody": "Only the video goes — the set stays.",
  "@clipPlayerDeleteBody": {
    "description": "Body of the delete-clip dialog, answering the only question the title leaves open: the logged set and its weights and reps survive; just the recording is removed."
  },
  "clipPlayerMissing": "This clip is no longer on the phone.",
  "@clipPlayerMissing": {
    "description": "Shown in place of the player when the video file a set points at is gone — removed by hand, or lost with the app's storage."
  },
  "clipLabelLoadedReps": "{date} · set {number} · {weight} × {reps}",
  "@clipLabelLoadedReps": {
    "description": "What one filmed set is, in one line, in the clip reel and on the session recap: \"12 Mar · set 3 · 100 kg × 5\". The date is first because the reel is ordered by it. `weight` arrives already formatted with its unit. Keep the middle dots as the separators and the multiplication sign between the load and the reps.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMd",
        "example": "12 Mar"
      },
      "number": {
        "type": "int",
        "example": "3"
      },
      "weight": {
        "type": "String",
        "example": "100 kg"
      },
      "reps": {
        "type": "int",
        "example": "5"
      }
    }
  },
  "clipLabelLoadedHold": "{date} · set {number} · {weight} × {duration}",
  "@clipLabelLoadedHold": {
    "description": "clipLabelLoadedReps for a set held for time under load rather than repeated: \"12 Mar · set 2 · 20 kg × 45s\". Both `weight` and `duration` arrive already formatted with their units.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMd",
        "example": "12 Mar"
      },
      "number": {
        "type": "int",
        "example": "2"
      },
      "weight": {
        "type": "String",
        "example": "20 kg"
      },
      "duration": {
        "type": "String",
        "example": "45s"
      }
    }
  },
  "clipLabelReps": "{date} · set {number} · {reps, plural, =1{1 rep} other{{reps} reps}}",
  "@clipLabelReps": {
    "description": "clipLabelLoadedReps for a set done under no load — a push-up, a pull-up — where naming a weight would mean claiming it was zero.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMd",
        "example": "12 Mar"
      },
      "number": {
        "type": "int",
        "example": "3"
      },
      "reps": {
        "type": "int",
        "example": "12"
      }
    }
  },
  "clipLabelHold": "{date} · set {number} · {duration}",
  "@clipLabelHold": {
    "description": "clipLabelLoadedReps for a set held for time under no load — a plank, a dead hang. `duration` arrives already formatted with its unit.",
    "placeholders": {
      "date": {
        "type": "DateTime",
        "format": "MMMd",
        "example": "12 Mar"
      },
      "number": {
        "type": "int",
        "example": "2"
      },
      "duration": {
        "type": "String",
