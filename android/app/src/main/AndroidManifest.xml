<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Workout reminders are scheduled alarms on this device: this lets the
         notification plugin lay them down again after a reboot, which is
         otherwise where every pending reminder goes to die. No exact-alarm
         permission — reminders are scheduled inexactly on purpose, see
         lib/services/reminders.dart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- The end of a rest, laid down as an exact alarm.

         This is the permission that makes a rest audible from a pocket. The
         countdown is a timer inside the app's process, and Android is free to
         kill that process the moment the app is backgrounded — so the ding is
         handed over in advance, for the instant the rest will end, and Android
         makes it whether the app is alive or not. See
         lib/services/rest_alarm.dart.

         USE_EXACT_ALARM rather than SCHEDULE_EXACT_ALARM: it is granted at
         install rather than through a settings screen, and it is the one
         intended for alarms and timers the user set themselves, which is
         exactly what a rest timer is. SCHEDULE_EXACT_ALARM is declared
         alongside it only for Android 12, where it was still auto-granted and
         USE_EXACT_ALARM did not exist yet.

         Note the workout reminders stay *inexact* on purpose — a nudge to go to
         the gym does not need to land on the second. See
         lib/services/reminders.dart. -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32"/>
    <!-- The live workout in the notification shade. A foreground service is not
         about drawing the notification — an ordinary one would do that — it is
         about the *process*: the session is held in memory and never written
         until Finish, so a "Done" press has to reach the isolate that holds it.
         Without this Android is free to kill the app once it is backgrounded,
         and the press would land somewhere with no workout in it. See
         lib/services/workout_shade.dart and issue #37.

         Android 14 requires a foregroundServiceType, and none of the declared
         ones fits a workout log cleanly:

           health        the closest in meaning, but it has a runtime
                         requirement — one of BODY_SENSORS,
                         ACTIVITY_RECOGNITION or HIGH_SAMPLING_RATE_SENSORS —
                         and asking an offline app's users for activity
                         recognition to show a rest timer is a bad trade.
           shortService  capped at three minutes. A workout is not.
           dataSync      semantically wrong, and Android 15 caps it at six
                         hours a day.

         So specialUse, with the subtype spelled out. It is the type for
         exactly this: a legitimate long-running foreground task the other
         categories do not describe. Note it needs a justification at Play
         Store review — see issue #24. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE"/>
    <!-- Android 13+ will not show any notification without it being granted,
         including this one and the workout reminders. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Keeps the rest countdown ticking with the screen off, which is the
         whole point of putting the workout in the shade. -->
    <uses-permission android:name="android.permission.WAKE_LOCK"/>
    <!-- The rest-finished notification buzzes as well as sounding: a phone in a
         gym bag is not always somewhere a ding carries. See
         lib/services/rest_alarm.dart. -->
    <uses-permission android:name="android.permission.VIBRATE"/>
    <application
        android:label="Foss Lift"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!-- Shared things arrive as fosslift://<host>/<code>, which is what
                 a shared link and a scanned QR both contain: theme/FLT1.… for a
                 colour theme, routine/FLR1.… for a routine. **Every host the
                 app shares needs a filter here**, or the link is inert outside
                 the app however well routeForLink handles it — routines were
                 shareable for a while with no filter to catch them.

                 A custom scheme rather than an https App Link on purpose: it
                 needs no domain, no hosting and no network, so it cannot stop
                 working when nobody is paying for a server. An https filter can
                 be added alongside this one later without invalidating any code
                 already shared — the payload after the prefix is identical. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="fosslift" android:host="theme"/>
                <data android:scheme="fosslift" android:host="routine"/>
            </intent-filter>
        </activity>
        <!-- The live-workout foreground service. The name is the plugin's and
             must not change. -->
        <service
            android:name="com.pravera.flutter_foreground_task.service.ForegroundService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Keeps a workout in progress on screen in the notification shade, with its rest timer, while the phone is put away."/>
        </service>
        <!-- The notification plugin's receivers: one to show a scheduled
             reminder when its alarm fires, one to re-schedule everything after
             a reboot or an app update. -->
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationReceiver" />
        <receiver
            android:exported="false"
            android:name="com.dexterous.flutterlocalnotifications.ScheduledNotificationBootReceiver">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED"/>
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED"/>
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON"/>
            </intent-filter>
        </receiver>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- Android 11+ hides installed apps from us unless we say what we
             intend to hand off to. Without this the demo-link button cannot
             see that a browser exists and the launch is simply refused. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:scheme="https"/>
        </intent>
    </queries>
</manifest>
