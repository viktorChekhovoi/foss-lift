<!-- The status-bar icon: the barbell from design/icon/foss-lift.svg, alone.

     Android treats a small icon as a *stencil* — it throws the colour away and
     fills the alpha channel with a flat tint. So this is white on nothing, and
     the launcher icon it replaced rendered as a featureless blob: that art is an
     opaque rounded plate, whose alpha is the plate.

     The wordmark is dropped and the barbell is redrawn shorter and thicker than
     the source. At 24dp the real 336:110 bar is under two pixels of bar between
     two hairlines, and the letters are mush. What survives is the silhouette:
     two plates a side, chunky, with air between them. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- The bar, fully rounded, running the width of the glyph. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M4.2,9.8 H19.8 A2.2,2.2 0 0 1 19.8,14.2 H4.2 A2.2,2.2 0 0 1 4.2,9.8 Z" />
    <!-- Inner plates. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M6.1,3 H7.5 A0.9,0.9 0 0 1 8.4,3.9 V20.1 A0.9,0.9 0 0 1 7.5,21 H6.1 A0.9,0.9 0 0 1 5.2,20.1 V3.9 A0.9,0.9 0 0 1 6.1,3 Z" />
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M16.5,3 H17.9 A0.9,0.9 0 0 1 18.8,3.9 V20.1 A0.9,0.9 0 0 1 17.9,21 H16.5 A0.9,0.9 0 0 1 15.6,20.1 V3.9 A0.9,0.9 0 0 1 16.5,3 Z" />
    <!-- Outer plates. -->
    <path
        android:fillColor="#FFFFFF"
        android:pathData="M2.7,6.6 H3.5 A0.7,0.7 0 0 1 4.2,7.3 V16.7 A0.7,0.7 0 0 1 3.5,17.4 H2.7 A0.7,0.7 0 0 1 2,16.7 V7.3 A0.7,0.7 0 0 1 2.7,6.6 Z" />
    <path
