        android:pathData="M20.5,6.6 H21.3 A0.7,0.7 0 0 1 22,7.3 V16.7 A0.7,0.7 0 0 1 21.3,17.4 H20.5 A0.7,0.7 0 0 1 19.8,16.7 V7.3 A0.7,0.7 0 0 1 20.5,6.6 Z" />
