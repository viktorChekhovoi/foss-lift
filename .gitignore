# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own output tree, distinct from the /build/ above: the root
# build.gradle.kts redirects module output there, but Gradle still writes its
# problem reports here — and one of them was committed once already.
/android/build/

# Packaged builds, wherever they land
*.apk
*.aab

# Claude Code's local working state
.claude/

# Release artifacts, built not committed.
/dist/

# Kotlin compiler session files, written by the Android build.
android/.kotlin/
