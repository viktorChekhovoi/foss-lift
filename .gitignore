# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle's own output tree, distinct from the /build/ above: the root
# build.gradle.kts redirects module output there, but Gradle still writes its
# problem reports here — and one of them was committed once already.
/android/build/

# Packaged builds, wherever they land
*.apk
*.aab
*.zip

# Claude Code's local working state
.claude/

# Release artifacts, built not committed.
/dist/
/release/

# Kotlin compiler session files, written by the Android build.
android/.kotlin/

# The feature catalogue's pages. Built from features/*.yaml by
# `dart run tool/features.dart`, which is the source of truth — committing the
# output as well would mean reviewing 400 KB of generated markup on every entry
# that changed a word, and would let the two disagree. Generate them; they are
# not in a fresh clone until you do.
/features/*.html

# The foreground-service demonstration video. Recorded from an emulator by the
# scripts beside it, which are checked in and are the source of truth; the take
# itself is a 1.5 MB binary that a diff cannot review and that every clone would
# carry for good. Record it when Play asks for it — see that README.
/design/play/foreground-service/*.mp4

# Localisations. The .arb catalogues are the source and are committed; the Dart
# gen_l10n builds from them is not, and neither is the list of keys a locale has
# not answered yet — both are rebuilt by `flutter gen-l10n`. See l10n.yaml.
lib/l10n/app_localizations*.dart
lib/l10n/untranslated.json


.vscode